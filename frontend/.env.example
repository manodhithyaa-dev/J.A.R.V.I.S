# Existing JARVIS backend base URL. Keep secrets on the backend, never here.
VITE_API_BASE_URL=http://localhost:8000

# API routes expected by this starter. Adapt src/lib/api.ts to your backend contract.
VITE_CHAT_ENDPOINT=/api/chat
VITE_MODELS_ENDPOINT=/api/models
VITE_HEALTH_ENDPOINT=/api/health

# Optional: set to true if your backend accepts OpenAI-compatible /v1/chat/completions.
VITE_OPENAI_COMPATIBLE=false